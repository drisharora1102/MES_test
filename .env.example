# Copy this file to .env to change settings. Remove the leading # to turn a setting on.

# Anthropic API key (https://platform.claude.com, Settings > API keys). With a key, answers come from the
# Claude API. Without one, they come from Claude Code on your Claude plan, if it's signed in.
ANTHROPIC_API_KEY=

# How to answer: auto, api, claude-code or search. auto uses the API when a key is set, else Claude Code.
# BACKEND=auto

# Model and effort. EFFORT is low, medium, high, xhigh or max: higher is more thorough, slower and costlier.
# In claude-code mode, leaving MODEL unset uses your plan's default model; opus, sonnet or haiku also work.
# Sonnet and Haiku start answering in about half the time and use less of the plan.
# MODEL=claude-opus-5-5
# EFFORT=low

# Path to the Claude Code program, if it isn't found automatically.
# CLAUDE_CLI=C:\Users\you\.vscode\extensions\anthropic.claude-code-<version>\resources\native-binary\claude.exe

# Where the chat page is served. HOST=0.0.0.0 lets others on the network open it; it has no login.
# PORT=3000
# HOST=127.0.0.1
